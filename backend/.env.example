# Flask Environment Configuration
# Copy this file to .env and update with your settings

# Flask environment: development, testing, or production
FLASK_ENV=development

# Secret key for session management (generate a strong random key for production)
SECRET_KEY=your-secret-key-here

# Database URL (optional, defaults to sqlite:///quiz.db)
# DATABASE_URL=sqlite:///quiz.db

# Open Trivia DB API settings (optional, uses defaults if not set)
# TRIVIA_API_BASE_URL=https://opentdb.com
# TRIVIA_API_RATE_LIMIT=5
# TRIVIA_API_TIMEOUT=10

# CORS origins (comma-separated list)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
